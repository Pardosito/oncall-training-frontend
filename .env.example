# Every VITE_* value is PUBLIC: it ends up in the JS bundle. Never put a secret here.
# Copy to .env.local and adjust.

# cognito | dev. `dev` skips Cognito and sends x-dev-user (only with `pnpm dev`; builds refuse it).
VITE_AUTH_MODE=dev
VITE_DEV_USER=alice

# Starts MSW in the browser so no backend is needed (`pnpm dev:mocks` sets it for you). Dev only.
VITE_API_MOCKS=false

# Cognito (public IDs, from the infra repo's Terraform outputs). Required when VITE_AUTH_MODE=cognito.
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_AbC123
VITE_COGNITO_CLIENT_ID=exampleclientid
VITE_COGNITO_DOMAIN=https://oncall-training.auth.us-east-1.amazoncognito.com

# Not a VITE_* var: where `pnpm dev` proxies /api. Default http://localhost:3000.
# For the Nov 5 MVP: API_PROXY_TARGET=http://<alb-dns> (DECISIONS D-18)
# API_PROXY_TARGET=http://localhost:3000
